# Copiar para .env.local e preencher. NUNCA fazer commit de .env.local.
# Em produção/preview, estas variáveis são definidas no painel da Vercel (Settings → Environment Variables).
# Variáveis sem o prefixo NEXT_PUBLIC_ só existem no servidor — é aí que ficam as chaves.

# ── Base de dados (Neon Postgres, via Vercel Marketplace) — WEB-25 ──────────────
DATABASE_URL=

# ── Armazenamento de CVs (Vercel Blob, store PRIVADA) — WEB-25 ───────────────────
BLOB_READ_WRITE_TOKEN=

# ── Email transacional (Resend) — WEB-08 / WEB-26 ────────────────────────────────
RESEND_API_KEY=
# Remetente. Antes do domínio verificado (WEB-17) usar: JEFAI <onboarding@resend.dev>
EMAIL_FROM=
# Quem recebe as mensagens do formulário de contacto
CONTACT_INBOX=jefaicoimbra@gmail.com
# Quem recebe a notificação de nova candidatura (RH)
RECRUITMENT_INBOX=jefaicoimbra@gmail.com
